AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com
AZURE_OPENAI_API_KEY=sua-chave-aqui
AZURE_OPENAI_DEPLOYMENT=nome-do-seu-deployment
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SPEECH_KEY=sua-chave-do-recurso-speech
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=pt-BR-Luana:MAI-Voice-2.1-Flash
AZURE_SPEECH_VOICE_LUANA=pt-BR-Luana:MAI-Voice-2.1-Flash
AZURE_SPEECH_VOICE_CAIO=pt-BR-Caio:MAI-Voice-2.1-Flash
AZURE_SPEECH_VOICE_PEDRO=pt-BR-AntonioNeural
PORT=3000
APP_BASE_PATH=
HALLOWEEN_SPEECH_STYLE=whispering
HALLOWEEN_SPEECH_STYLE_DEGREE=1.3
HALLOWEEN_SPEECH_RATE=-15%
HALLOWEEN_SPEECH_PITCH=-20%
HALLOWEEN_SPEECH_PITCH_LUANA=-13%
HALLOWEEN_SPEECH_PITCH_CAIO=-17%
HALLOWEEN_SPEECH_PITCH_PEDRO=-10%
HALLOWEEN_PROMPT=Interaja com os convidados como uma conversa de Halloween, com Luana a fantasma, Caio o vampiro e Pedro o zelador. Responda ao que a pessoa disser, pergunte seu nome e use-o de vez em quando em uma micro-história de susto fictícia, absurda e bem-humorada. Faça pegadinhas leves, com suspense e risada curta; não ameace, não grite, não assuste com áudio alto e repentino, não use violência gráfica, armas nem dados pessoais não ditos.
